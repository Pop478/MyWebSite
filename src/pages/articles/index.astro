---

import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
	(first, second) => second.data.pubDate.valueOf() - first.data.pubDate.valueOf(),
)
---

<BaseLayout title="Articles | My Website" description="Browse the latest articles.">
	<h1>Articles</h1>
	<p>Notes about Astro, writing, and keeping a website simple.</p>

	<ul class="article-list">
		{
			articles.map((article) => (
				<li>
					<article>
						<p class="date">
							<time datetime={article.data.pubDate.toISOString()}>
								{article.data.pubDate.toLocaleDateString('en-US', {
									day: 'numeric',
									month: 'long',
									year: 'numeric',
								})}
							</time>
						</p>
						<h2><a href={`/articles/${article.id}/`}>{article.data.title}</a></h2>
						<p>{article.data.description}</p>
						{article.data.tags.length > 0 && (
							<ul class="tags" aria-label="Article tags">
								{article.data.tags.map((tag) => <li>{tag}</li>)}
							</ul>
						)}
					</article>
				</li>
			))
		}
	</ul>
</BaseLayout>

<style>
	.article-list,
	.tags {
		padding: 0;
		list-style: none;
	}

	.article-list {
		display: grid;
		gap: 1.5rem;
		margin-block: 2rem;
	}

	.article-list article {
		padding: 1.5rem;
		background: white;
		border-radius: 0.75rem;
		box-shadow: 0 1px 3px rgb(15 23 42 / 12%);
	}

	.article-list h2 {
		margin-block: 0.25rem;
	}

	.date {
		margin: 0;
		color: #52606d;
		font-size: 0.9rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1rem 0 0;
	}

	.tags li {
		padding: 0.15rem 0.6rem;
		color: #0f5132;
		background: #d1fae5;
		border-radius: 999px;
		font-size: 0.85rem;
	}
</style>
