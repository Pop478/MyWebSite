---

import { getCollection, render, type CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'

export async function getStaticPaths() {
	const projects = await getCollection('projects', ({ data }) => !data.draft)

	return projects.map((project) => ({
		params: { id: project.id },
		props: { project },
	}))
}

interface Props {
	project: CollectionEntry<'projects'>
}

const { project } = Astro.props
const { Content } = await render(project)

const statusLabels = {
	completed: 'Completed',
	'in-progress': 'In progress',
	concept: 'Concept',
} as const
---

<BaseLayout>
	<article class="project">
		<header class="project-header">
			<p class="eyebrow">{project.data.category} · {statusLabels[project.data.status]}</p>
			<h1>{project.data.title}</h1>
			<p class="lead">{project.data.description}</p>
			{project.data.technologies.length > 0 && (
				<ul class="technologies" aria-label="Technologies and materials">
					{project.data.technologies.map((technology) => <li>{technology}</li>)}
				</ul>
			)}
		</header>
		<div class="project-content">
			<Content />
		</div>
		<footer class="project-footer">
			<div class="project-links">
				{project.data.externalUrl && (
					<a href={project.data.externalUrl} target="_blank" rel="noopener noreferrer">View project <span aria-hidden="true">↗</span></a>
				)}
				{project.data.repositoryUrl && (
					<a href={project.data.repositoryUrl} target="_blank" rel="noopener noreferrer">Source code <span aria-hidden="true">↗</span></a>
				)}
			</div>
			<p><a href="/projects/">← Back to projects</a></p>
		</footer>
	</article>
</BaseLayout>

<style>
	.project {
		width: min(100% - 2 * var(--page-padding), 56rem);
		margin: 0 auto;
		padding-block: clamp(3rem, 8vw, 7rem) 4rem;
	}

	.project-header {
		padding-bottom: 3rem;
		border-bottom: 1px solid var(--color-text);
	}

	.eyebrow {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	h1 {
		margin: 1rem 0 0;
		font-size: clamp(3rem, 9vw, 6rem);
		letter-spacing: -0.07em;
		line-height: 1;
	}

	.lead {
		max-width: 42rem;
		margin: 1.5rem 0 0;
		font-size: clamp(1.1rem, 2vw, 1.35rem);
	}

	.technologies {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 0;
		margin: 2rem 0 0;
		list-style: none;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.technologies li {
		padding: 0.3rem 0.55rem;
		border: 1px solid var(--color-text);
	}

	.project-content {
		padding-block: 3rem;
	}

	.project-content :global(h2) {
		margin-top: 2.5rem;
		font-size: clamp(1.75rem, 4vw, 2.75rem);
		letter-spacing: -0.04em;
	}

	.project-content :global(a) {
		text-underline-offset: 0.15em;
	}

	.project-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--color-text);
	}

	.project-footer p {
		margin: 0;
	}

	.project-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		font-weight: 700;
	}

	@media (max-width: 42rem) {
		.project-footer {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
