---

import { getCollection } from 'astro:content'
import ArticleDate from '../components/ArticleDate.astro'
import BaseLayout from '../layouts/BaseLayout.astro'

const latestBlogPosts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((first, second) => second.data.pubDate.valueOf() - first.data.pubDate.valueOf())
	.slice(0, 3)

const latestProjects = (await getCollection('projects', ({ data }) => !data.draft))
	.sort(
		(first, second) =>
			Number(second.data.featured) - Number(first.data.featured) ||
			second.data.pubDate.valueOf() - first.data.pubDate.valueOf(),
	)
	.slice(0, 3)

const statusLabels = {
	completed: 'Completed',
	'in-progress': 'In progress',
	concept: 'Concept',
} as const
---

<BaseLayout>
	<section class="hero" aria-labelledby="hero-heading">
		<p class="eyebrow">Personal website · 2026</p>
		<h1 id="hero-heading">Привет, это <span>stepanusik</span><span class="dot">.</span></h1>
		<p class="hero-copy">
			Личное пространство для заметок, идей и небольших экспериментов в вебе.
		</p>
		<div class="hero-actions">
			<a class="button button-primary" href="/blog/">Читать блог</a>
			<a class="button button-secondary" href="/projects/">Смотреть проекты</a>
		</div>
	</section>

	<section class="content-section" aria-labelledby="blog-heading">
		<div class="section-heading">
			<div>
				<p class="eyebrow">Latest notes</p>
				<h2 id="blog-heading">Последние записи</h2>
			</div>
			<a class="text-link" href="/blog/">Все записи <span aria-hidden="true">↗</span></a>
		</div>

		{
			latestBlogPosts.length > 0 ? (
				<ul class="content-list">
					{latestBlogPosts.map((post) => (
						<li class="content-card">
							<a href={`/blog/${post.id}/`}>
								<h3>{post.data.title}</h3>
								<p>{post.data.description}</p>
								<div class="card-footer">
									{post.data.tags.length > 0 && (
										<ul class="tags" aria-label="Post tags">
											{post.data.tags.map((tag) => <li>{tag}</li>)}
										</ul>
									)}
									<ArticleDate date={post.data.pubDate} locale="en-US" />
								</div>
							</a>
						</li>
					))}
				</ul>
			) : (
				<p class="empty-state">Новые записи появятся здесь совсем скоро.</p>
			)
		}
	</section>

	<section class="content-section" aria-labelledby="projects-heading">
		<div class="section-heading">
			<div>
				<p class="eyebrow">Selected work</p>
				<h2 id="projects-heading">Проекты</h2>
			</div>
			<a class="text-link" href="/projects/">Все проекты <span aria-hidden="true">↗</span></a>
		</div>

		{
			latestProjects.length > 0 ? (
				<ul class="content-list">
					{latestProjects.map((project) => (
						<li class="content-card">
							<a href={`/projects/${project.id}/`}>
								<p class="card-meta">
									{project.data.category} · {statusLabels[project.data.status]}
								</p>
								<h3>{project.data.title}</h3>
								<p>{project.data.description}</p>
								<div class="card-footer">
									{project.data.technologies.length > 0 && (
										<ul class="tags" aria-label="Technologies and materials">
											{project.data.technologies.map((technology) => <li>{technology}</li>)}
										</ul>
									)}
									<ArticleDate date={project.data.pubDate} locale="en-US" />
								</div>
							</a>
						</li>
					))}
				</ul>
			) : (
				<p class="empty-state">Опубликованные проекты появятся здесь совсем скоро.</p>
			)
		}
	</section>
</BaseLayout>

<style>
	:global(main) {
		padding: 0;
	}

	.hero,
	.content-section {
		padding: clamp(2.5rem, 7vw, 7rem) var(--page-padding);
	}

	.hero {
		min-height: min(42rem, calc(100svh - 4.5rem));
		display: grid;
		align-content: center;
		background: var(--color-bg);
		border-bottom: 1px solid var(--color-text);
	}

	.hero > *,
	.content-section > * {
		width: min(100%, var(--container-width));
		margin-inline: auto;
	}

	.eyebrow,
	.card-meta {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.eyebrow {
		margin: 0 0 1.25rem;
	}

	h1 {
		max-width: 14ch;
		margin: 0;
		font-size: clamp(3.25rem, 10vw, 8rem);
		letter-spacing: -0.07em;
	}

	h1 span {
		color: var(--color-white);
		-webkit-text-stroke: 1px var(--color-text);
	}

	h1 .dot {
		color: var(--color-accent);
		-webkit-text-stroke: 0;
	}

	.hero-copy {
		max-width: 38rem;
		margin: 2rem 0 0;
		font-size: clamp(1.125rem, 2vw, 1.4rem);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.button {
		padding: 0.75rem 1rem;
		border: 1px solid var(--color-text);
		font-weight: 700;
		text-decoration: none;
		transition: transform 150ms ease, background-color 150ms ease, color 150ms ease;
	}

	.button:hover,
	.button:focus-visible {
		transform: translate(-0.2rem, -0.2rem);
		box-shadow: 0.25rem 0.25rem 0 var(--color-text);
	}

	.button-primary {
		color: var(--color-text);
		background: var(--color-white);
	}

	.button-secondary {
		color: var(--color-white);
		background: var(--color-text);
	}

	.content-section {
		background: var(--color-bg-2);
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 2.5rem;
	}

	.section-heading .eyebrow {
		margin-bottom: 0.5rem;
	}

	h2 {
		margin: 0;
		font-size: clamp(2rem, 5vw, 4rem);
		letter-spacing: -0.05em;
	}

	.text-link {
		flex: 0 0 auto;
		font-weight: 700;
	}

	.content-list,
	.tags {
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.content-list {
		display: grid;
		gap: 1.5rem;
	}

	.content-card,
	.empty-state {
		padding: var(--page-padding);
		background: var(--color-bg-3);
		border: 2px solid var(--color-accent);
		box-shadow: 3px 3px 0 var(--color-accent);
	}

	.content-card {
		transition: 0.3s all ease;
	}

	.content-card:hover {
		transform: translate(3px);
		box-shadow: 0 0 0 0;
	}

	.content-card a {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.card-meta {
		margin: 0;
		color: var(--color-muted);
	}

	h3 {
		margin: 0.25rem 0;
		font-size: 1.5rem;
		letter-spacing: -0.03em;
	}

	.content-card h3 + p {
		margin: 0.75rem 0 0;
	}

	.card-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 1rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tags li {
		padding: 0.15rem 0.6rem;
		color: var(--color-text);
		background: var(--color-bg-2);
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}

	.empty-state {
		margin: 0;
	}

	@media (max-width: 48rem) {
		.section-heading,
		.card-footer {
			align-items: flex-start;
			flex-direction: column;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.button,
		.content-card {
			transition: none;
		}

		.button:hover,
		.button:focus-visible {
			transform: none;
		}
	}
</style>
